{
  "languages": {
    "Svelte": {
      "language_servers": ["svelte-language-server", "tailwindcss-language-server"],
      "formatter": "prettier",
      "format_on_save": "on"
    },
    "TypeScript": {
      "language_servers": ["vtsls", "biome", "tailwindcss-language-server"],
      "formatter": { "language_server": { "name": "biome" } },
      "format_on_save": "on"
    },
    "JavaScript": {
      "language_servers": ["vtsls", "biome", "tailwindcss-language-server"],
      "formatter": { "language_server": { "name": "biome" } },
      "format_on_save": "on"
    },
    "CSS": {
      "language_servers": ["tailwindcss-language-server", "biome"],
      "formatter": { "language_server": { "name": "biome" } }
    },
    "JSON": {
      "formatter": { "language_server": { "name": "biome" } }
    }
  }
}
